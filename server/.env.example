# Copy this file to .env (in this same server/ folder) and fill in real
# values — never commit .env.

# Neon/Vercel Postgres — pooled connection string (has "-pooler" in the hostname).
# Used by the app's runtime Prisma client.
DATABASE_URL=

# Neon/Vercel Postgres — direct (non-pooled) connection string, no "-pooler".
# Used only by `prisma migrate` / `prisma db seed` / `prisma db pull`.
DIRECT_URL=

# Random 32+ byte secret used to sign auth JWTs.
JWT_SECRET=

# Vercel Blob (Storage tab of the Vercel project).
BLOB_STORE_ID=
BLOB_READ_WRITE_TOKEN=

# IGDB (via Twitch OAuth) — from a Twitch developer app at
# dev.twitch.tv/console/apps. Used only to suggest title/genre/cover in the
# add-game flow — server-side only, never exposed to client/.
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=

# Local port for the Express API (used by `server/src/index.ts`).
PORT=3001
