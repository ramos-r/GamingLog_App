generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Visibility {
  PUBLIC // anyone, logged in or not, sees the full profile
  FRIENDS // only accepted friends see the full profile; others see the username
  PRIVATE // only the owner sees the profile; never listed in user search
}

model User {
  id           String       @id @default(cuid())
  username     String       @unique
  passwordHash String
  bio          String?      @db.VarChar(280)
  avatarUrl    String?
  visibility   Visibility   @default(FRIENDS)
  socialLinks  SocialLink[]
  games        UserGame[]
  createdAt    DateTime     @default(now())

  friendshipsAsA Friendship[] @relation("FriendshipsAsA")
  friendshipsAsB Friendship[] @relation("FriendshipsAsB")
}

enum FriendshipStatus {
  PENDING
  ACCEPTED
}

// One row per pair of users, whichever of them sent the request. The pair is
// always stored in canonical order (userAId < userBId) so the unique
// constraint makes a duplicate or crossed request impossible at the database
// level.
model Friendship {
  id          String           @id @default(cuid())
  userAId     String
  userBId     String
  requesterId String // which of userAId / userBId sent the request
  status      FriendshipStatus @default(PENDING)
  createdAt   DateTime         @default(now())
  acceptedAt  DateTime?

  userA User @relation("FriendshipsAsA", fields: [userAId], references: [id], onDelete: Cascade)
  userB User @relation("FriendshipsAsB", fields: [userBId], references: [id], onDelete: Cascade)

  @@unique([userAId, userBId])
  @@index([userAId, status])
  @@index([userBId, status])
}

model SocialLink {
  id       String @id @default(cuid())
  platform String // "steam" | "xbox" | "playstation" | ...
  handle   String
  order    Int    @default(0) // display order on the profile header, user-reorderable
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Game {
  id        String     @id @default(cuid())
  title     String
  genre     String?
  coverUrl  String?
  // year / publisher: future fields, see PLAN.md Section 14
  addedById String? // which user first added it to the catalog (nullable: seeded rows have none)
  users     UserGame[]
  createdAt DateTime   @default(now())

  @@index([title])
}

enum Category {
  PLAYING
  PLAYED_BEFORE
  WANT_TO_PLAY
}

model UserGame {
  id               String   @id @default(cuid())
  userId           String
  gameId           String
  category         Category
  platform         String? // local-only, per CLAUDE.md — never on Game
  rating           Int? // 1-5, whole stars only for v1
  isFavorite       Boolean  @default(false)
  // Order inside the user's category (lower first) and inside their Favorites
  // row. Ties fall back to addedAt, newest first.
  position         Int      @default(0)
  favoritePosition Int      @default(0)
  addedAt          DateTime @default(now())
  updatedAt        DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  game Game @relation(fields: [gameId], references: [id], onDelete: Cascade)

  @@unique([userId, gameId]) // one library entry per user per game
}
